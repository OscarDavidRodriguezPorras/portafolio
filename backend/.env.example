# Puerto donde correrá el servidor
PORT=4000

# Contraseña de administrador (la que usabas antes: 1101261349)
# Cámbiala por una nueva, esta ya no vive en el código del navegador.
ADMIN_PASSWORD=cambia_esta_contraseña

# Cadena secreta larga y aleatoria para firmar los tokens de sesión (JWT)
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esta_cadena_por_una_larga_y_aleatoria

# Ruta al archivo JSON de la cuenta de servicio de Google (ver README.md)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ID del archivo skills.json en Google Drive
# (se obtiene de la URL al abrir el archivo: drive.google.com/file/d/ESTE_ES_EL_ID/view)
DRIVE_SKILLS_FILE_ID=id_de_tu_archivo_skills.json

# ID del archivo projects.json en Google Drive
DRIVE_PROJECTS_FILE_ID=id_de_tu_archivo_projects.json

# URL de tu frontend, para configurar CORS correctamente en producción
# En desarrollo local puedes dejar *, pero en producción pon tu dominio real.
FRONTEND_URL=*
